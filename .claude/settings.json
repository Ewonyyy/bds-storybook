{
  "model": "claude-sonnet-5",
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | grep -o '\"display_name\":\"[^\"]*\"' | head -n1 | sed -E 's/.*:\"(.*)\"/\\1/'); branch=$(git --no-optional-locks branch --show-current 2>/dev/null); echo \"${model:-Claude} | ${branch:-no branch}\""
  },
  "env": {
    "SESSION_START_SKILL": ""
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(rm:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session-start.py"
          }
        ]
      }
    ]
  }
}
